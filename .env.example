# ============================================================
# TRUSTSPHERE DEPLOYMENT CONFIGURATION (.env)
# ============================================================

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=TrustSphereDB

# Security & Authentication
JWT_SECRET=trustsphere-production-super-secure-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Default Administrator (Created idempotently on startup)
ADMIN_EMAIL=admin@trustsphere.com
ADMIN_PASSWORD=Admin@123

# Frontend API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api

# Automatic Watched-Folder Ingestion
INGESTION_ENABLED=true
INGESTION_FOLDER=./ingestion
INGESTION_INTERVAL_SECONDS=10

# Automatic Email Ingestion via IMAP (Optional)
EMAIL_INGESTION_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=security-ingest@example.com
IMAP_PASSWORD=replace-with-secure-app-password
IMAP_FOLDER=INBOX
EMAIL_POLL_INTERVAL=60

# Groq AI Configuration (Placeholders Only — Configure real key in backend/.env)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google / Gmail OAuth 2.0 Configuration (Placeholders Only — Do NOT commit secrets)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/ingestion/email/oauth/callback
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_ANALYSIS_MODE=both

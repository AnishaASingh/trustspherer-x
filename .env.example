# ============================================================
# TRUSTSPHERE DEPLOYMENT CONFIGURATION (.env)
# ============================================================

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=TrustSphereDB

# Security & Authentication
JWT_SECRET=trustsphere-production-super-secure-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Default Administrator (Created idempotently on startup)
ADMIN_EMAIL=admin@trustsphere.com
ADMIN_PASSWORD=Admin@123

# Frontend & Backend Origin Configuration
# For Localhost:
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://trustspherer-x-1.onrender.com
FRONTEND_URL=https://trustspherer-x-1.onrender.com

# Frontend API Target (Vite)
# Localhost development:
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
# Render deployment:
# VITE_API_URL=https://trustspherer-x.onrender.com
# VITE_API_BASE_URL=https://trustspherer-x.onrender.com/api

# Automatic Watched-Folder Ingestion
INGESTION_ENABLED=true
INGESTION_FOLDER=./ingestion
INGESTION_INTERVAL_SECONDS=10

# Automatic Email Ingestion via IMAP (Optional)
EMAIL_INGESTION_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=security-ingest@example.com
IMAP_PASSWORD=replace-with-secure-app-password
IMAP_FOLDER=INBOX
EMAIL_POLL_INTERVAL=60

# Groq AI Configuration (Placeholders Only — Configure real key in backend/.env)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google / Gmail OAuth 2.0 Configuration (Placeholders Only — Configure real keys in backend/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/ingestion/email/oauth/callback
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_ANALYSIS_MODE=both
